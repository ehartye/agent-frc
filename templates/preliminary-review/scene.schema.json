{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-frc/preliminary-review-scene@2",
  "title": "Agent FRC preliminary review scene",
  "description": "The only input of the stock preliminary design review page. design preliminary-page builds it from the design source, the judgement file, the page file and the library's records; seasons supply data, not markup. Each property's `x-supplier` says who provides it: `plugin` (derived from the design source, the judgement file, the verdict or the records), `page` (page.json; a missing value renders as 'Not supplied in this review' and validates with a warning) or `optional` (a feature that hides cleanly when absent).",
  "type": "object",
  "required": [
    "schema",
    "issue",
    "design",
    "sources",
    "records",
    "decision",
    "unmet",
    "reopen",
    "premises",
    "palette",
    "meshes",
    "bodies",
    "cases",
    "openingCase",
    "parked",
    "weight",
    "power",
    "required",
    "narrativeReview",
    "motionEvidence",
    "animations",
    "returnCriteria",
    "interactions",
    "adjustments"
  ],
  "properties": {
    "schema": {
      "const": "agent-frc/preliminary-review-scene@2",
      "x-supplier": "plugin"
    },
    "issue": {
      "type": "string",
      "minLength": 1,
      "x-supplier": "plugin",
      "description": "Layout issue identifier; the page heading."
    },
    "design": {
      "type": "string",
      "minLength": 1,
      "x-supplier": "plugin",
      "description": "The design's name in its design source."
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "x-supplier": "page",
      "description": "page.json title: the release's human title, shown as the page heading; the issue ID is used when absent."
    },
    "context": {
      "type": [
        "string",
        "null"
      ],
      "x-supplier": "page",
      "description": "page.json context: the line above the heading, such as the project and iteration."
    },
    "architecture": {
      "type": [
        "string",
        "null"
      ],
      "x-supplier": "page",
      "description": "page.json architecture: the selected whole-robot architecture."
    },
    "focus": {
      "type": [
        "string",
        "null"
      ],
      "x-supplier": "page",
      "description": "page.json focus: what the reviewer should look at first."
    },
    "notes": {
      "type": [
        "array",
        "null"
      ],
      "x-supplier": "page",
      "description": "page.json notes: model basis and limits.",
      "items": {
        "type": "string"
      }
    },
    "datum": {
      "type": [
        "string",
        "null"
      ],
      "x-supplier": "plugin",
      "description": "The design source's frame, in words."
    },
    "units": {
      "type": "string",
      "x-supplier": "plugin"
    },
    "links": {
      "type": "array",
      "x-supplier": "page",
      "description": "page.json links: header links to season pages.",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "cutaway": {
      "type": [
        "object",
        "null"
      ],
      "x-supplier": "page",
      "description": "page.json cutaway: a toggle that hides named fixtures and outlines an opening, for example a target aperture.",
      "required": [
        "label",
        "hides"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "hides": {
          "$ref": "#/$defs/ids"
        },
        "outline": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "x-supplier": "plugin",
      "required": [
        "design",
        "narrative",
        "page"
      ],
      "additionalProperties": false,
      "description": "The design source (its library fingerprint, which covers every subsystem file), the narrative and the page file, each with the digest read.",
      "properties": {
        "design": {
          "$ref": "#/$defs/pin"
        },
        "narrative": {
          "$ref": "#/$defs/pinOrNull"
        },
        "page": {
          "$ref": "#/$defs/pinOrNull"
        }
      }
    },
    "records": {
      "type": "object",
      "x-supplier": "plugin",
      "required": [
        "folder",
        "jobs",
        "trials"
      ],
      "additionalProperties": false,
      "description": "The library's records the verdict was judged from: each job record the judgement asked for, and trials.json.",
      "properties": {
        "folder": {
          "type": "string"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "file",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "trials": {
          "$ref": "#/$defs/pinOrNull"
        }
      }
    },
    "decision": {
      "type": "object",
      "x-supplier": "plugin",
      "required": [
        "status",
        "firstUnmet"
      ],
      "additionalProperties": false,
      "description": "The verdict judged from the records when the scene was built: its status and its first unmet requirement.",
      "properties": {
        "status": {
          "enum": [
            "layout-checked",
            "provisional",
            "blocked",
            "reopen"
          ]
        },
        "firstUnmet": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    "unmet": {
      "type": "array",
      "x-supplier": "plugin",
      "description": "Every unmet requirement of the verdict, blocking first.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "text"
        ]
      }
    },
    "reopen": {
      "type": "array",
      "x-supplier": "plugin",
      "description": "What the verdict reopens: the phase, the reason and the groups affected.",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "reason"
        ]
      }
    },
    "premises": {
      "type": "array",
      "x-supplier": "plugin",
      "description": "Each accepted premise, judged against the fact it observes.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ]
      }
    },
    "palette": {
      "type": "object",
      "x-supplier": "plugin",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "meshes": {
      "type": "array",
      "x-supplier": "plugin",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "v",
          "f"
        ],
        "properties": {
          "v": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "minItems": 3
          },
          "f": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "bodies": {
      "type": "object",
      "x-supplier": "plugin",
      "minProperties": 1,
      "description": "Every placed ID and fixture, keyed by stable ID.",
      "additionalProperties": {
        "$ref": "#/$defs/body"
      }
    },
    "cases": {
      "type": "array",
      "x-supplier": "plugin",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      },
      "description": "One case per motion of the design source, then the displaced control."
    },
    "openingCase": {
      "type": "string",
      "x-supplier": "plugin"
    },
    "animations": {
      "type": "array",
      "x-supplier": "plugin",
      "description": "The animation list: one entry per phase of the judgement's cycle, playing its motions end to end, then each motion outside the cycle. page.json phases gives a phase a title and says whether it is a headline mission animation.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "mission",
          "cases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "mission": {
            "type": "boolean"
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "parked": {
      "type": "object",
      "x-supplier": "plugin",
      "required": [
        "screenedPairs",
        "positive",
        "unresolved"
      ],
      "description": "The checker's parked-assembly result: pairs screened, positive-volume pairs and unresolved pairs.",
      "properties": {
        "screenedPairs": {
          "type": "integer",
          "minimum": 0
        },
        "positive": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pair",
              "volumeMm3"
            ],
            "properties": {
              "pair": {
                "$ref": "#/$defs/pair"
              },
              "volumeMm3": {
                "type": "number"
              }
            }
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        }
      }
    },
    "weight": {
      "type": "object",
      "x-supplier": "plugin",
      "required": [
        "totalKg",
        "rangeKg",
        "notRobotWeight",
        "unweighed",
        "groups",
        "extraMass",
        "limits"
      ],
      "additionalProperties": false,
      "description": "The weight from the design source's masses, as the mass record states it, against each of the season's weight limits.",
      "properties": {
        "totalKg": {
          "type": "number"
        },
        "rangeKg": {
          "$ref": "#/$defs/interval"
        },
        "notRobotWeight": {
          "$ref": "#/$defs/ids"
        },
        "unweighed": {
          "$ref": "#/$defs/ids"
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "massKg",
              "rangeKg",
              "members",
              "extra"
            ],
            "properties": {
              "massKg": {
                "type": "number"
              },
              "rangeKg": {
                "$ref": "#/$defs/interval"
              },
              "members": {
                "$ref": "#/$defs/ids"
              },
              "extra": {
                "$ref": "#/$defs/ids"
              }
            },
            "additionalProperties": false
          }
        },
        "extraMass": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "group",
              "rangeKg"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "rangeKg": {
                "$ref": "#/$defs/interval"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "limitKg",
              "excludesGroups",
              "rangeKg",
              "marginKg",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "limitKg": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "excludesGroups": {
                "$ref": "#/$defs/ids"
              },
              "basis": {
                "type": "string"
              },
              "rangeKg": {
                "$ref": "#/$defs/interval"
              },
              "marginKg": {
                "type": "number"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "power": {
      "type": "object",
      "x-supplier": "plugin",
      "required": [
        "minBusV",
        "conservative",
        "motions"
      ],
      "additionalProperties": false,
      "description": "Each powered motion's electrical record as judged: every running drive's current and needed motor voltage, and the bus under all of them.",
      "properties": {
        "minBusV": {
          "type": [
            "number",
            "null"
          ]
        },
        "conservative": {
          "type": [
            "string",
            "null"
          ]
        },
        "motions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "motion",
              "status",
              "busV",
              "loadA",
              "requiredV",
              "marginV",
              "drives",
              "alsoRunning"
            ],
            "additionalProperties": false,
            "properties": {
              "motion": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "busV": {
                "$ref": "#/$defs/interval"
              },
              "loadA": {
                "$ref": "#/$defs/interval"
              },
              "requiredV": {
                "type": "number"
              },
              "governs": {
                "type": "string"
              },
              "marginV": {
                "type": "number"
              },
              "clamped": {
                "$ref": "#/$defs/ids"
              },
              "openCircuitV": {
                "$ref": "#/$defs/interval"
              },
              "resistanceOhm": {
                "$ref": "#/$defs/interval"
              },
              "drives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "drive",
                    "kind",
                    "currentA",
                    "motorV",
                    "limitA",
                    "clamped",
                    "busA",
                    "members"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "drive": {
                      "type": "string"
                    },
                    "motor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "motorSolid": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "count": {
                      "type": "number"
                    },
                    "group": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "kind": {
                      "type": "string"
                    },
                    "change": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    },
                    "currentA": {
                      "$ref": "#/$defs/interval"
                    },
                    "neededA": {
                      "$ref": "#/$defs/interval"
                    },
                    "limitA": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "motorV": {
                      "$ref": "#/$defs/interval"
                    },
                    "clamped": {
                      "type": "boolean"
                    },
                    "busA": {
                      "$ref": "#/$defs/interval"
                    },
                    "members": {
                      "$ref": "#/$defs/ids"
                    }
                  }
                }
              },
              "alsoRunning": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "drive",
                    "busA",
                    "members"
                  ],
                  "properties": {
                    "drive": {
                      "type": "string"
                    },
                    "busA": {
                      "$ref": "#/$defs/interval"
                    },
                    "members": {
                      "$ref": "#/$defs/ids"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "required": {
      "type": "array",
      "x-supplier": "plugin",
      "description": "Each role a preliminary layout must hold and the solids of the groups that hold it, from the design source.",
      "items": {
        "type": "object",
        "required": [
          "role",
          "ids"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "ids": {
            "$ref": "#/$defs/ids"
          }
        },
        "additionalProperties": false
      }
    },
    "narrativeReview": {
      "type": "object",
      "x-supplier": "plugin",
      "properties": {
        "source": {
          "$ref": "#/$defs/pinOrNull"
        },
        "objectives": {
          "type": "array"
        }
      }
    },
    "motionEvidence": {
      "type": "array",
      "x-supplier": "plugin",
      "items": {
        "type": "object",
        "required": [
          "case",
          "kind",
          "result"
        ]
      }
    },
    "returnCriteria": {
      "type": "object",
      "x-supplier": "plugin",
      "required": [
        "preliminary",
        "conceptual"
      ]
    },
    "interactions": {
      "type": "array",
      "x-supplier": "plugin",
      "description": "The verdict's interactions: screen verdict and reasons, override, and the trial's result, assumptions, inputs, sensitivity, coverage and state.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "verdict",
          "reasons"
        ]
      }
    },
    "adjustments": {
      "type": "array",
      "x-supplier": "plugin",
      "description": "The verdict's adjustments: kind, input, range and, for a mechanical one, whether both ends were measured and what came close there.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "range",
          "measured"
        ]
      }
    },
    "attachment": {
      "type": "object",
      "x-supplier": "plugin",
      "description": "The verdict's attachment report at the start of the cycle: robot solids with no path of contacts or registered mounts to the frame, labelled unmounted allowances and field fixtures off the floor.",
      "required": [
        "motion"
      ],
      "properties": {
        "pose": {
          "type": "string"
        },
        "skipped": {
          "type": "string"
        },
        "gapMm": {
          "type": "number"
        },
        "floorZMm": {
          "type": "number"
        },
        "robotSolids": {
          "type": "integer",
          "minimum": 0
        },
        "frameSolids": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "object"
        },
        "floating": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "solid",
              "group",
              "nearest",
              "gapMm"
            ],
            "properties": {
              "solid": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "nearest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gapMm": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "heldByMountOnly": {
          "$ref": "#/$defs/ids"
        },
        "onUnmountedAllowance": {
          "$ref": "#/$defs/ids"
        },
        "unmountedAllowances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "solid",
              "group",
              "reason",
              "reachesFrame"
            ],
            "properties": {
              "solid": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "reachesFrame": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "fixturesOffFloor": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fixture",
              "lowestAboveFloorMm"
            ],
            "properties": {
              "fixture": {
                "type": "string"
              },
              "lowestAboveFloorMm": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "suspendedFixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fixture",
              "reason",
              "lowestAboveFloorMm"
            ],
            "properties": {
              "fixture": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "lowestAboveFloorMm": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "motion": {
          "type": "string"
        },
        "mountsOffHost": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "replays": {
      "type": "array",
      "x-supplier": "optional",
      "description": "One replay per trial with a nominal trace in the records folder's trials.json: playback in the same animation list and view as the motions. A replay is evidence playback, not a clearance case: the verdict neither runs nor credits it.",
      "items": {
        "$ref": "#/$defs/replay"
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "pinOrNull": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "pattern": "^(https://[A-Za-z0-9.-]+(/[^\\s\\\\]*)?|(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\s\\\\/][^\\s\\\\]*)$",
          "description": "Relative to the release page, or https: with a host. No other scheme."
        }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "number"
      }
    },
    "body": {
      "type": "object",
      "required": [
        "name",
        "category",
        "role",
        "color",
        "motionGroup",
        "fixture",
        "volumeMm3",
        "closed",
        "description",
        "massKg",
        "massRangeKg",
        "massFrom",
        "massExcluded",
        "motorOf"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "page.json solids, else the solid's name in the design source."
        },
        "category": {
          "type": "string",
          "description": "What the article is; colours the model and legend."
        },
        "role": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "subsystem": {
          "type": [
            "string",
            "null"
          ],
          "x-supplier": "page",
          "description": "Which function it serves: page.json solids, else its group."
        },
        "motionGroup": {
          "type": "string",
          "description": "What it moves with."
        },
        "material": {
          "type": [
            "string",
            "null"
          ],
          "x-supplier": "page"
        },
        "volumeMm3": {
          "type": [
            "number",
            "null"
          ]
        },
        "closed": {
          "type": "boolean"
        },
        "fixture": {
          "type": "boolean"
        },
        "massExcluded": {
          "type": [
            "string",
            "null"
          ]
        },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "x-supplier": "plugin",
          "description": "Mounts the design source registers against this member: the host, the point and its note.",
          "items": {
            "type": "object",
            "required": [
              "on",
              "pointMm",
              "basis"
            ],
            "properties": {
              "on": {
                "type": "string"
              },
              "pointMm": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "basis": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "page.json solids, else the solid's note in the design source."
        },
        "massKg": {
          "type": [
            "number",
            "null"
          ]
        },
        "massRangeKg": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "massFrom": {
          "enum": [
            "massKg",
            "densityKgM3",
            "group",
            null
          ]
        },
        "motorOf": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The drives whose motor this solid is."
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "purpose",
        "cause",
        "basis",
        "status",
        "bodies",
        "removed",
        "results"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "nominal",
            "displaced control"
          ]
        },
        "basis": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "allowanceMm": {
          "type": [
            "number",
            "null"
          ]
        },
        "bodies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "mesh",
              "matrices"
            ],
            "properties": {
              "mesh": {
                "type": "integer",
                "minimum": 0
              },
              "matrices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/matrix"
                }
              }
            }
          }
        },
        "removed": {
          "$ref": "#/$defs/ids"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pair",
              "status"
            ],
            "properties": {
              "pair": {
                "$ref": "#/$defs/pair"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "time": {
          "type": "array",
          "description": "Seconds per frame: a driven motion's nominal duration on the library's triangle speed profile, from rest to rest.",
          "items": {
            "type": "number"
          }
        },
        "measure": {
          "type": "array",
          "description": "The readout per frame: each drive's joint value and peak current and the bus voltage, or the cause of a motion no motor drives.",
          "items": {
            "type": "string"
          }
        },
        "purpose": {
          "enum": [
            "operating",
            "park",
            "service"
          ]
        },
        "cause": {
          "type": [
            "string",
            "null"
          ],
          "description": "drive, or the cause a motion no motor drives states: hand, spring, gravity or piece."
        }
      },
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "required": [
        "id",
        "label",
        "basis",
        "evidence",
        "time",
        "follow",
        "bodies",
        "groups"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique among cases and replays; the ?case= deep link."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "description": "What was recorded and under which model."
        },
        "objective": {
          "type": [
            "string",
            "null"
          ],
          "description": "The reviewed narrative objective this replay plays, when it plays one."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "description": "The trial or trace files this replay plays back, each pinned by SHA-256.",
          "items": {
            "type": "object",
            "required": [
              "file",
              "sha256"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "role": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "recorded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Motions taken from the trial files."
        },
        "display": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Motions prescribed or interpolated for display; they carry no contact or load claim."
        },
        "time": {
          "type": "array",
          "minItems": 1,
          "description": "Seconds per frame, never decreasing. The frame count of the replay.",
          "items": {
            "type": "number"
          }
        },
        "measure": {
          "type": "array",
          "description": "Live readout per frame.",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "description": "Named moments, in frame order.",
          "items": {
            "type": "object",
            "required": [
              "frame",
              "label"
            ],
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "follow": {
          "type": "string",
          "description": "The group whose position the robot view follows: the robot base in the field frame."
        },
        "bodies": {
          "type": "object",
          "minProperties": 1,
          "description": "The bodies shown. `group` names the rigid group the body moves with; null keeps it where its mesh was drawn.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "mesh",
              "group"
            ],
            "properties": {
              "mesh": {
                "type": "integer",
                "minimum": 0
              },
              "group": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "object",
          "description": "One transform per frame for each rigid group, in the field frame, applied to the meshes as drawn. A null frame hides the group, so one piece body can serve several deliveries.",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "tubes": {
          "type": "array",
          "description": "Flexible parts that follow a centerline, such as a chain, rope or hose. `points` holds one centerline for a fixed part or one per frame for a deforming one, in the field frame. With `radiusMm` and `color` the part is drawn as a round tube. With `body` and `mesh` it is that field body's mesh, each vertex moved by the displacement, since the first centerline, of the nearest point on it.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "points"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "radiusMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "description": "A field body, not otherwise shown in this replay, whose mesh the centerline carries."
              },
              "mesh": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
